{
  "name": "@bwf/backend",
  "private": true,
  "version": "0.0.0",
  "description": "API de Blackjack with Friends (Node + SQLite)",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@bwf/engine": "*",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2"
  }
}
