{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "module": "nodenext",
    "skipLibCheck": true,
    "strict": true,

    /* `npm run build` compiles to dist/ with tsconfig.build.json; this one only type-checks. */
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api", "lib", "routes", "server.ts", "drizzle.config.ts"]
}
