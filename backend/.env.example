# Copia este archivo como .env.local y rellénalo (solo para desarrollo local).
# En Vercel van en el proyecto del backend → Settings → Environment Variables.
# Son secretos: nunca en el frontend, nunca en GitHub, nunca en un chat.

# Neon → tu base de datos → Connect → cadena de conexión (la "pooled").
DATABASE_URL=

# Cadena aleatoria larga para firmar las sesiones: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# URL del frontend (donde vive la cookie de sesión). En local: http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173

# Resend → API Keys. Si la dejas vacía en local, el código sale en la terminal de la API.
RESEND_API_KEY=
# Remitente. Con un dominio verificado en Resend: "Blackjack with Friends <hola@tudominio.com>"
EMAIL_FROM=Blackjack with Friends <onboarding@resend.dev>
