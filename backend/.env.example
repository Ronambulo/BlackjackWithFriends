# Copia este archivo como .env.local si quieres cambiar algo en desarrollo; sin él
# también funciona. En el contenedor van en docker-compose.yml.
# Son secretos: nunca en el frontend, nunca en GitHub, nunca en un chat.

# Dónde se guarda la base de datos SQLite. Por defecto: backend/data/blackjack.db
# DATABASE_PATH=

# Cadena aleatoria larga para firmar las sesiones: `openssl rand -base64 32`.
# En el contenedor se genera sola la primera vez y se guarda en /data.
BETTER_AUTH_SECRET=
# URL desde la que se abre la app (donde vive la cookie de sesión).
BETTER_AUTH_URL=http://localhost:5173
# Otros orígenes desde los que se puede abrir, separados por comas (p. ej. la IP de la red local).
# BETTER_AUTH_TRUSTED_ORIGINS=
