# Copia este archivo como .env.local y rellénalo (solo para desarrollo local).
# En Vercel se ponen en el proyecto del backend → Settings → Environment Variables.
SUPABASE_URL=
# Clave SECRETA (Supabase → Project Settings → API Keys → Secret keys).
# Nunca en el frontend, nunca en GitHub, nunca en un chat.
SUPABASE_SECRET_KEY=
