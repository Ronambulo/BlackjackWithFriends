{
  "name": "blackjackwithfriends",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "frontend",
    "backend"
  ],
  "scripts": {
    "postinstall": "npm run build -w @bwf/engine",
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev -w @bwf/backend\" \"npm run dev -w @bwf/frontend\"",
    "build": "npm run build --workspaces",
    "test": "npm run test -w @bwf/engine",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "oxlint"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "oxlint": "^1.81.0"
  }
}
