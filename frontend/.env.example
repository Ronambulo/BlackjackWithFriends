# Copia este archivo como .env.local y rellénalo.
# Supabase → tu proyecto → Project Settings → API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública ("Publishable key"). Es pública por diseño: va dentro de la app.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional: dónde está el backend en local (por defecto http://localhost:3001).
# API_ORIGIN=
